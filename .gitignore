# Obsidian: track only the plugin manifest (the recommended-plugins list).
# Everything else under .obsidian/ (app.json, appearance.json, core-plugins.json,
# themes/, workspace*.json, plugin binaries) is per-person local state.
.obsidian/*
!.obsidian/community-plugins.json

# Obsidian export/attachment formats we don't track
*.hml
*.xlsx

# OS / editor noise
.DS_Store

# Local Claude Code settings only — shared rules live in .claude/RULES.md (tracked)
.claude/settings.local.json
